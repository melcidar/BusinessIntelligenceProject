    {
      "@id": "db://airq/dwh_034/ft_readingevent",
      "@type": "prov:Entity",
      "dct:title": "ft_readingevent",
      "rowCount": 513286,
      "dct:description": "Grain: One row per sensor reading of a specific environmental parameter by a device on a given day.",
      "measures": [
        {
          "name": "reading_value",
          "agg": "AVG"
        },
        {
          "name": "data_volume",
          "agg": "SUM",
          "fully_additive": true
        },
        {
          "name": "data_quality_score",
          "agg": "AVG"
        }
      ]
    },
    {
      "@id": "db://airq/dwh_034/ft_serviceevent",
      "@type": "prov:Entity",
      "dct:title": "ft_serviceevent",
      "rowCount": 326,
      "dct:description": "Grain: One row per maintenance or service event performed by a technician on a specific device.",
      "measures": [
        {
          "name": "servicecost",
          "agg": "SUM",
          "fully_additive": true
        },
        {
          "name": "durationminutes",
          "agg": "SUM",
          "fully_additive": true
        },
        {
          "name": "servicequality",
          "agg": "AVG"
        }
      ]
    },
